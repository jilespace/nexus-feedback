# Database
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/nexus_feedback

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-random-64-char-hex-string-min-32-chars

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf

# Storage: local, s3, oss, qiniu
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads

# S3 (optional)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@nexus-feedback.dev

# Frontend URL (for password reset links)
BASE_URL=http://localhost:8080
