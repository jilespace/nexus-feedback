# Database
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_feedback

# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-random-64-char-hex-string-min-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173

# Upload limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf

# Storage: local | s3 | oss
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads

# AWS S3, required when STORAGE_TYPE=s3
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Aliyun OSS, required when STORAGE_TYPE=oss
OSS_BUCKET=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

